# ==============================================================================
# Productio Full Stack Environment Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Place in backend/.env)
# ------------------------------------------------------------------------------
# Database connection string:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/productio

# Allowed CORS origins (comma-separated):
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application metadata & debug flags:
APP_NAME=Productio — Personal Day Tracker
APP_VERSION=0.1.0
DEBUG=False

# ------------------------------------------------------------------------------
# Frontend Configuration (Place in frontend/.env)
# ------------------------------------------------------------------------------
# Backend proxy destination for Vite dev server:
VITE_BACKEND_URL=http://localhost:8000

# Base URL for API client:
VITE_API_BASE_URL=/api
